# Скопируйте в .env и заполните. Файл .env в git не коммитится (проверьте .gitignore).

# Доменное имя демо, например azimut-demo.duckdns.org
DOMAIN=

# Доступ к LLM (выдаёт организатор). Ключ перестаёт работать после окончания приёма решений:
# жюри подставляет свой ключ и адрес.
ALFA_LLM_API_KEY=
ALFA_LLM_BASE_URL=

# Идентификаторы моделей. По умолчанию в call_llm.py стоят id со шлюза организаторов
# (список: curl -H "Authorization: Bearer $ALFA_LLM_API_KEY" "$ALFA_LLM_BASE_URL/models").
# Раскомментируйте только те, что у вас отличаются. Пустое значение игнорируется.
# ALFA_MODEL_CHEAP_CLASSIFY=
# ALFA_MODEL_BULK_RANK=
# ALFA_MODEL_DEEP_LINKS=
# ALFA_MODEL_GENERATION=
# ALFA_MODEL_SELF_CHECK=
# ALFA_MODEL_VISION=

# Модель эмбеддингов для RAG по материалам банка. По умолчанию intfloat/multilingual-e5-large;
# если не хватает памяти на сервере, возьмите intfloat/multilingual-e5-base и пересоберите индекс.
# RAG_MODEL=
