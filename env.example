# Скопируйте в .env и заполните. Файл .env в git не коммитится (проверьте .gitignore).

# Доменное имя демо, например azimut-demo.duckdns.org
DOMAIN=

# Доступ к LLM (выдаёт организатор). Ключ перестаёт работать после окончания приёма решений:
# жюри подставляет свой ключ и адрес.
ALFA_LLM_API_KEY=
ALFA_LLM_BASE_URL=

# Идентификаторы моделей из письма организаторов. Раскомментируйте только те, что отличаются
# от значений по умолчанию в call_llm.py. Пустое значение здесь затрёт значение по умолчанию.
# ALFA_MODEL_CHEAP_CLASSIFY=
# ALFA_MODEL_BULK_RANK=
# ALFA_MODEL_DEEP_LINKS=
# ALFA_MODEL_GENERATION=
# ALFA_MODEL_SELF_CHECK=
# ALFA_MODEL_VISION=
